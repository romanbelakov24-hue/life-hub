# ─── Turso (libSQL) ────────────────────────────────────────────────────────────
# Получить значения:
#   1) npm i -g turso                      (или веб-панель app.turso.tech)
#   2) turso auth login
#   3) turso db create life-hub
#   4) turso db show life-hub --url        -> TURSO_DATABASE_URL
#   5) turso db tokens create life-hub     -> TURSO_AUTH_TOKEN
#
# Если переменные не заданы, приложение работает на локальном файле ./local.db —
# удобно для разработки, но данные не синхронизируются между устройствами.
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# ─── Ускорение холодного старта (необязательно) ────────────────────────────────
# Пропускает CREATE TABLE / seed-запрос при старте функции — экономит один
# сетевой круг до базы на каждом холодном старте. Включай в проде ТОЛЬКО после
# того, как таблицы точно уже созданы (сайт хоть раз открывался без этой
# переменной, или прогнан scripts/migrate.ts) — иначе первый же запрос упадёт
# с «no such table». Локально не нужна: ./local.db и так быстрый.
# SKIP_SCHEMA_INIT=true

# ─── Постоянный адрес сайта (рекомендуется в проде) ────────────────────────────
# Без неё ссылки на календарь / вебхук здоровья / публичную сводку собираются
# из заголовков запроса — а у Netlify на каждый деплой есть ещё и отдельный
# превью-адрес (<id>--life-hub8.netlify.app). Если открыть сайт именно через
# него и скопировать оттуда ссылку, она будет вести на этот конкретный деплой
# и сломается на следующей сборке. Задай настоящий адрес сайта — и ссылки
# всегда будут вести на него, независимо от того, через какой домен открыли
# страницу настроек.
# NEXT_PUBLIC_SITE_URL=https://life-hub8.netlify.app
