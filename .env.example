# Шаблон переменных. Куда что класть:
#
#   .env.local       — для `npm run dev`. Ключи боевой базы сюда НЕ класть:
#                      dev-сервер их всё равно игнорирует (работает с ./local.db),
#                      а сборка под Cloudflare зашивает этот файл в код воркера.
#   .env.prod.local  — ключи боевой базы для `npm run db:migrate:prod`.
#                      Его не читают ни Next.js, ни сборка — только скрипты с --prod.
#   секреты воркера  — то, что нужно сайту на Cloudflare:
#                      npx wrangler secret put <ИМЯ>

# ─── Turso (libSQL) — в .env.prod.local и в секреты воркера ────────────────────
# Получить значения:
#   1) npm i -g turso                      (или веб-панель app.turso.tech)
#   2) turso auth login
#   3) turso db create life-hub
#   4) turso db show life-hub --url        -> TURSO_DATABASE_URL
#   5) turso db tokens create life-hub     -> TURSO_AUTH_TOKEN
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# ─── Постоянный адрес сайта (рекомендуется в проде) ────────────────────────────
# Ссылки на календарь, вебхук здоровья и публичную сводку уходят наружу. Без
# этой переменной адрес берётся из заголовков запроса — задай настоящий, и
# ссылки всегда будут вести на него.
# NEXT_PUBLIC_SITE_URL=https://life-hub.aarara.workers.dev
